+  let max=0;for(let i=0;i<a.length;i+=3){const d=Math.hypot(a[i]-b[i],a[i+1]-b[i+1],a[i+2]-b[i+2]);if(!Number.isFinite(d))throw Error('nonfinite surface sample');max=Math.max(max,d);}return max;
